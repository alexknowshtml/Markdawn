# Database
DATABASE_URL=postgresql://user:password@localhost:5432/markdawn

# Better Auth
BETTER_AUTH_SECRET=your-secret-here-min-32-chars
FRONTEND_URL=http://localhost:5173

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# App
BASE_URL=http://localhost:5173
PORT=3001
COLLAB_PORT=1234

# CORS — comma-separated list of allowed origins (production only)
# Example: CORS_ORIGINS=https://app.yourdomain.com
CORS_ORIGINS=

# Environment
NODE_ENV=development

# Frontend (Vite - must have VITE_ prefix)
VITE_API_URL=http://localhost:3001
VITE_COLLAB_URL=ws://localhost:1234
