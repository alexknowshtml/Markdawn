+import type { CloseEvent } from "@hocuspocus/common";
+import type { Connection } from "./Connection.ts";
+import type { Document } from "./Document.ts";
+import type { MessageReceiver } from "./MessageReceiver.ts";
+
+export type MessageApplication = () => void;
+
+/** Explicit, server-scoped interception points for authorization-aware hosts. */
+export interface HocuspocusLifecycleHooks {
+	deferInitialAwareness?(connection: Connection): boolean;
+	beforeSend?(connection: Connection, message: unknown): boolean;
+	beforeClose?(
+		connection: Connection,
+		event: CloseEvent | undefined,
+		close: () => void,
+	): boolean;
+	applyMessage?(
+		receiver: MessageReceiver,
+		document: Document,
+		connection: Connection | undefined,
+		reply: ((message: Uint8Array) => void) | undefined,
+		apply: MessageApplication,
+	): void;
+}
