FROM node:24-slim AS base
WORKDIR /app
RUN corepack enable

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/api/package.json packages/api/package.json
COPY packages/collab/package.json packages/collab/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/web/package.json packages/web/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY packages/collab packages/collab
RUN pnpm --filter @markdawn/shared build && pnpm --filter @markdawn/collab build
RUN CI=true pnpm prune --prod

FROM node:24-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV COLLAB_PORT=1234
COPY --from=deps /app/node_modules /app/node_modules
COPY --from=build /app/packages/shared /app/packages/shared
COPY --from=build /app/packages/collab /app/packages/collab
EXPOSE 1234
CMD ["node", "/app/packages/collab/dist/index.js"]
