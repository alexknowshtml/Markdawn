FROM node:24-slim AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

# --- Deps: install production-only deps ---
FROM base AS deps
WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/shared/package.json packages/shared/package.json
COPY packages/api/package.json packages/api/package.json

# Install ONLY api + shared deps, production-only (prunes devDependencies)
RUN pnpm install --frozen-lockfile --filter @markdawn/api --filter @markdawn/shared --prod && pnpm store prune

# --- Build Deps: install all deps (including devDependencies for building) ---
FROM base AS build-deps
WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/shared/package.json packages/shared/package.json
COPY packages/api/package.json packages/api/package.json
RUN pnpm install --frozen-lockfile --filter @markdawn/api --filter @markdawn/shared

# --- Build: compile source ---
FROM build-deps AS build
WORKDIR /app
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY packages/api packages/api
RUN pnpm -C packages/shared run build
RUN pnpm -C packages/api run build

# --- Runner: final image ---
FROM node:24-slim AS runner
WORKDIR /app
ENV NODE_ENV=production

# Create non-root user for security
RUN addgroup -g 1000 -S markdawn && adduser -u 1000 -S markdawn -G markdawn

# Copy production node_modules (no devDependencies), owned by markdawn
COPY --from=deps --chown=markdawn:markdawn /app/node_modules ./node_modules
COPY --from=deps --chown=markdawn:markdawn /app/pnpm-workspace.yaml /app/package.json /app/pnpm-lock.yaml ./
COPY --from=deps --chown=markdawn:markdawn /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps --chown=markdawn:markdawn /app/packages/api/node_modules ./packages/api/node_modules

# Copy built packages, owned by markdawn
COPY --from=build --chown=markdawn:markdawn /app/packages/shared ./packages/shared
COPY --from=build --chown=markdawn:markdawn /app/packages/api ./packages/api

# Install dumb-init and wget for proper signal handling and health checks
RUN apt-get update && apt-get install -y --no-install-recommends dumb-init wget && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Health check for orchestrator visibility
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD wget -qO- http://localhost:3001/health || exit 1

EXPOSE 3001

# Switch to non-root before running
USER markdawn

# dumb-init ensures SIGTERM reaches Node properly
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "/app/packages/api/dist/index.mjs"]
