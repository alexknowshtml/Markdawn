[Unit]
Description=Markdawn Collaboration Server (Hocuspocus)
After=markdawn-api.service markdawn-postgres.service
Requires=markdawn-api.service markdawn-postgres.service

[Container]
Image=localhost/markdawn-collab:latest
ContainerName=markdawn-collab
Pod=markdawn.pod
Environment=NODE_ENV=production
Environment=COLLAB_PORT=1234
EnvironmentFile=/var/www/markdawn/.env
WorkingDir=/app
Exec=node /app/packages/collab/dist/index.js

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
